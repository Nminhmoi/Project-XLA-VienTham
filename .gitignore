# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.pt
!docs/best.pt
*.pth
runs/

# Virtual Environment
venv/
.venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE / Editor settings
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
~$*
~*
*.tmp

# Large remote sensing / GIS files in data (giữ lại cấu trúc thư mục nhờ .gitkeep)
# Bỏ comment nếu bạn muốn bỏ qua ảnh vệ tinh nặng (.tif, .nc, .hdf, .zip, v.v.):
# Large remote sensing/GIS data is shared separately (for example, through Drive).
data/*
!data/.gitkeep
!data/outputs/
data/outputs/*
!data/outputs/.gitkeep
!data/outputs/*.geojson
!data/outputs/*.json

# Raw drone images (shared via Drive)
plot_B03/

# YOLO palm dataset: chỉ commit nhãn + cấu hình.
# Ảnh tile cắt lại được từ COG bằng prepare_palm_dataset.py (seed=42) nên không commit.
!data/yolo_palm/
data/yolo_palm/images/
