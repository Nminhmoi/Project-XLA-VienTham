.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Large remote sensing / GIS files in data (giữ lại cấu trúc thư mục nhờ .gitkeep)
# Bỏ comment nếu bạn muốn bỏ qua ảnh vệ tinh nặng (.tif, .nc, .hdf, .zip, v.v.):
# data/*
# !data/.gitkeep
